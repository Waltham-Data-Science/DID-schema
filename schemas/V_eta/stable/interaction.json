    "rules": [
        {
            "name": "method_shared_and_own",
            "fields": [
                "method.term",
                "method.parameters.variable"
            ],
            "statement": "An interaction with `method_id` may also carry an inline `method` whose `parameters` add settings only this run had: its `term` is empty and no parameter variable is one of the shared method document's parameter variables (Jess Haley 2026-10-22 [method shared plus own], [rules and clock_alignment tenet])."
        }
    ]
