{
    "document_class": {
        "class_name": "file_reference",
        "class_version": "1.0.0",
        "superclasses": [
            {
                "class_name": "base"
            }
        ],
        "maturity_level": "stable"
    },
    "depends_on": [
        {
            "name": "document_id",
            "mustBeNonEmpty": false,
            "documentation": "Optional: the document this file is a reference to.",
            "must_refer_to_document_class": "base",
            "ndi_mustBeNonEmpty": false
        }
    ],
    "file": [],
    "fields": [
        {
            "name": "filename",
            "type": "char",
            "blank_value": "",
            "default_value": "",
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "The file's name with extension, without a directory (e.g. 'Opossum.tissue.gef').",
            "constraints": {}
        },
        {
            "name": "original_path",
            "type": "char",
            "blank_value": "",
            "default_value": "",
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "The full path the file was read from. A hint, not a promise: the checksum rather than this field identifies the file.",
            "constraints": {}
        },
        {
            "name": "format_ontology",
            "type": "char",
            "blank_value": "",
            "default_value": "",
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "The ontology node describing the file format in the form of ontology:nodeID (e.g. 'EMPTY:0000002'). Empty when not known.",
            "constraints": {}
        },
        {
            "name": "date_created",
            "type": "double",
            "blank_value": 0.0,
            "default_value": 0.0,
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "The time the file was created, as a datenum.",
            "constraints": {}
        },
        {
            "name": "date_updated",
            "type": "double",
            "blank_value": 0.0,
            "default_value": 0.0,
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "The time the file was last updated, as a datenum.",
            "constraints": {}
        },
        {
            "name": "file_size",
            "type": "double",
            "blank_value": 0.0,
            "default_value": 0.0,
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "The file's size in bytes, or 0 if it was not recorded.",
            "constraints": {}
        },
        {
            "name": "checksum",
            "type": "char",
            "blank_value": "",
            "default_value": "",
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "The checksum of the file's contents. Empty when not computed; empty means unknown and never means the file had no content.",
            "constraints": {}
        },
        {
            "name": "checksum_algorithm",
            "type": "char",
            "blank_value": "",
            "default_value": "MD5",
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "The algorithm the checksum was computed with (e.g. 'MD5').",
            "constraints": {}
        }
    ]
}
