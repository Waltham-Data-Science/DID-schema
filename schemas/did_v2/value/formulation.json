                                "source_value": 0.0,
                                "approximate": false,
                                "tolerance": {}
                            },
                            "mustBeNonEmpty": false,
                            "mustBeScalar": true,
                            "mustNotHaveNaN": false,
                            "queryable": true,
                            "ontology": null,
                            "documentation": "Volume, optional.",
                            "constraints": {}
                        },
                        {
                            "name": "substance_amount",
                            "type": "substance_amount",
                            "blank_value": 0.0,
                            "default_value": {
                                "moles": 0.0,
                                "source_unit": {
                                    "node": "",
                                    "name": ""
                                },
                                "source_value": 0.0,
                                "approximate": false,
                                "tolerance": {}
