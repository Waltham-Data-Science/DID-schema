{
    "document_class": {
        "class_name": "formulation",
        "class_version": "1.0.0",
        "superclasses": [
            {
                "class_name": "value"
            }
        ]
    },
    "depends_on": [
        {
            "name": "ingredient_id",
            "mustBeNonEmpty": false,
            "documentation": "What went in, in the order of `value.ingredients` (entry k describes edge k; the order carries no other meaning). A stock you made is a formulation; a live strain grown or suspended in it (bacteria in broth) is a `strain`.",
            "must_refer_to_document_class": "chemical,formulation,entity",
            "multiple": true,
            "ordered": true,
            "min_count": 0
        },
        {
            "name": "product_id",
            "mustBeNonEmpty": false,
            "documentation": "Optional: the bought product/lot, for a mixture bought ready-made (PBS tablets, saline).",
            "must_refer_to_document_class": "entity"
        }
    ],
    "file": [],
    "fields": [
        {
            "name": "value",
            "type": "structure",
            "blank_value": {},
            "default_value": {},
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "What you make: its ingredients and whole-mixture properties.",
            "constraints": {},
            "fields": [
                {
                    "name": "type",
                    "type": "ontology_term",
                    "blank_value": {
                        "node": "",
                        "name": ""
