                            "default_value": {
                                "count": 0,
                                "approximate": false,
                                "tolerance": {}
                            },
                            "mustBeNonEmpty": false,
                            "mustBeScalar": true,
                            "mustNotHaveNaN": false,
                            "queryable": true,
                            "ontology": null,
                            "documentation": "A count of entities (e.g. viral genomes), optional.",
                            "constraints": {}
                        },
                        {
                            "name": "concentration",
                            "type": "concentration",
                            "blank_value": 0.0,
                            "default_value": {
                                "molar": 0.0,
                                "grams_per_liter": 0.0,
                                "grams_per_gram": 0.0,
                                "liters_per_liter": 0.0,
                                "particles_per_liter": 0.0,
                                "osmolar": 0.0,
                                "optical_density": 0.0,
                                "source_unit": {
                                    "node": "",
                                    "name": ""
                                },
                                "source_value": 0.0,
                                "approximate": false,
                                "tolerance": {}
                            },
                            "mustBeNonEmpty": false,
                            "mustBeScalar": true,
                            "mustNotHaveNaN": false,
                            "queryable": true,
                            "ontology": null,
                            "documentation": "Optional: this ingredient's final concentration in the formulation.",
                            "constraints": {}
                        }
                    ]
                },
                {
                    "name": "ph",
                    "type": "ph",
                    "blank_value": 0.0,
                    "default_value": {
                        "ph": 0.0,
                        "source_unit": {
                            "node": "",
                            "name": ""
                        },
                        "source_value": 0.0,
                        "approximate": false,
                        "tolerance": {}
                    },
                    "mustBeNonEmpty": false,
                    "mustBeScalar": true,
                    "mustNotHaveNaN": false,
                    "queryable": true,
                    "ontology": null,
                    "documentation": "Optional: the finished mixture's pH.",
                    "constraints": {}
                },
                {
                    "name": "osmolarity",
                    "type": "concentration",
                    "blank_value": 0.0,
                    "default_value": {
                        "molar": 0.0,
                        "grams_per_liter": 0.0,
                        "grams_per_gram": 0.0,
                        "liters_per_liter": 0.0,
                        "particles_per_liter": 0.0,
                        "osmolar": 0.0,
                        "optical_density": 0.0,
                        "source_unit": {
                            "node": "",
                            "name": ""
                        },
                        "source_value": 0.0,
                        "approximate": false,
                        "tolerance": {}
                    },
                    "mustBeNonEmpty": false,
                    "mustBeScalar": true,
                    "mustNotHaveNaN": false,
                    "queryable": true,
                    "ontology": null,
                    "documentation": "Optional: the finished mixture's osmolarity (the `osmolar` slot).",
                    "constraints": {}
                }
            ]
        }
    ],
    "rules": [
        {
            "name": "ingredients_or_product",
            "fields": [
                "value.ingredients",
                "product_id"
            ],
            "statement": "A formulation lists its `ingredients` or points at the `product` it was bought as (or both)."
        }
    ]
