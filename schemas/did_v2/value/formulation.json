                    "default_value": {
                        "node": "",
                        "name": ""
                    },
                    "mustBeNonEmpty": false,
                    "mustBeScalar": true,
                    "mustNotHaveNaN": false,
                    "queryable": true,
                    "ontology": null,
                    "documentation": "Optional: what kind of mixture this is -- the standard recipe or medium it is (e.g. S-Complete, LB, NGM). It classifies the formulation; what it IS stays its ingredients (or its product). Left out for a one-off mixture (a day's dilution). Bound like `statement.variable`.",
                    "constraints": {
                        "binding": {
                            "strength": "preferred",
                            "node_form": "curie"
                        }
                    },
                    "fields": [
                        {
                            "name": "node",
                            "type": "char",
                            "blank_value": "",
                            "default_value": "",
                            "mustBeNonEmpty": false,
                            "mustBeScalar": true,
                            "mustNotHaveNaN": false,
                            "queryable": true,
                            "ontology": null,
                            "documentation": "The CURIE (prefix resolved via CURIE_lookups_meta.json).",
                            "constraints": {}
                        },
                        {
                            "name": "name",
                            "type": "char",
                            "blank_value": "",
                            "default_value": "",
