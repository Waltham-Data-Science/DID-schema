    "rules": [
        {
            "name": "ingredients_match_edges",
            "fields": [
                "value.ingredients",
                "ingredient_id"
            ],
            "statement": "`value.ingredients` has exactly one entry per `ingredient_id` edge on the dose, in the same order (entry k describes edge k, 0-based). Checkable on the dose alone."
        },
        {
            "name": "ingredient_in_formulation",
            "fields": [
                "ingredient_id",
                "formulation_id"
            ],
            "statement": "Each `ingredient_id` on a dose is also one of the `ingredient_id` edges of the formulation its `formulation_id` names. Not checkable on the dose alone -- it needs the formulation document -- so it is a batch (database) check, or a builder check when the formulation is at hand (Jess Haley, 2026-10-21 [dose per ingredient])."
        }
    ]
