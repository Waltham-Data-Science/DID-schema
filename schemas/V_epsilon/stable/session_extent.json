            "constraints": {}
        },
        {
            "name": "end",
            "type": "timestamp",
            "blank_value": "",
            "default_value": "",
            "mustBeNonEmpty": false,
            "mustBeScalar": true,
            "mustNotHaveNaN": false,
            "queryable": true,
            "ontology": null,
            "documentation": "UTC end of the session (optional; at least one of start/end must be present).",
            "constraints": {}
        },
        {
